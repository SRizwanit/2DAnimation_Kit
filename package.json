{
  "name": "hadis-story-kit",
  "version": "1.0.0",
  "private": true,
  "description": "প্রতিদিন একটি হাদিস — গল্প আকারে ভিডিও সিরিজ (React + Remotion + GitHub Actions)",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "render": "node scripts/render.mjs",
    "still": "remotion still src/index.ts HadisStory out/preview.png --frame=120 --props=data/hadis0000.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/google-fonts": "4.0.250",
    "@remotion/media-utils": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
